# 运行环境：dev | staging | prod
APP_ENV=dev

# MQ：MVP 使用 mock（fixture 入站 + 本地文件出站）；接入真实 MQ 时改为 kafka
MQ_BACKEND=mock
MQ_BOOTSTRAP_SERVERS=mock:local
MQ_CONSUMER_GROUP=label-agent-consumer
MQ_INGRESS_TOPIC=agent.task.ingress
MQ_INGRESS_DLQ_TOPIC=agent.task.ingress.dlq
MQ_CALLBACK_TOPIC_WHITELIST=agent.task.callback
VECTOR_EVENT_TOPIC=tag.created
VECTOR_CONSUMER_GROUP=label-agent-vector-worker
MQ_MOCK_INGRESS_FIXTURE=configs/fixtures/mq_ingress_sample.json
MQ_MOCK_REPLAY=once
MQ_MOCK_RECEIPT_DIR=var/receipts

# Tag Service（D007：部署形态由 tag_service.deployment_mode 决定，此处仅示例）
TAG_SERVICE_BASE_URL=http://localhost:8081
TAG_SERVICE_TIMEOUT_MS=3000
TAG_SERVICE_AUTH_TOKEN=

# Milvus 代理
MILVUS_PROXY_BASE_URL=http://localhost:8082
MILVUS_PROXY_TIMEOUT_MS=5000
# S4 生产类目召回；启用 milvus 时 taxonomy version 必填
S4_CATEGORY_RETRIEVAL_BACKEND=local
S4_CATEGORY_VECTOR_COLLECTION=product_category_vectors
S4_TAXONOMY_VERSION=

# 对象存储
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=label-agent-media
# S1/S2 远程证书材料域名白名单，多个域名用逗号分隔
CERTIFICATE_MEDIA_ALLOWED_DOMAINS=

# S4 远程商品图片域名白名单，多个域名用逗号分隔；本地路径/data URL 无需配置
S4_MEDIA_ALLOWED_DOMAINS=

# LLM Provider（多模型切换，详见 configs/base.yaml -> inference.models）
# OpenAI 兼容协议：可填官方或任意三方网关（如 Azure/代理/自建 OpenAI-compatible）
# 切勿将真实密钥提交到仓库；本地请复制本文件为 .env 后填写
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-06-01
LOCAL_VLLM_BASE_URL=http://localhost:8000/v1

# 配置中心 / Feature Flag
CONFIG_CENTER_BASE_URL=http://localhost:8090
CONFIG_CENTER_NAMESPACE=label-agent

# 可观测性
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO
