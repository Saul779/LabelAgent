{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ContentLabelResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "biz_id",
    "result_revision",
    "dictionary_snapshot_version",
    "model_run_id",
    "prompt_version",
    "policy_version",
    "primary_category",
    "tags"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "biz_id": { "type": "string" },
    "data_version": { "type": ["integer", "null"] },
    "result_revision": { "type": "integer" },
    "dictionary_snapshot_version": { "type": "string" },
    "model_run_id": { "type": "string" },
    "prompt_version": { "type": "string" },
    "policy_version": { "type": "string" },
    "primary_category": { "$ref": "#/definitions/category" },
    "secondary_category": {
      "anyOf": [{ "$ref": "#/definitions/category" }, { "type": "null" }]
    },
    "tags": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": { "$ref": "#/definitions/tag" }
    },
    "degraded_modalities": { "type": "array", "items": { "type": "string" } },
    "perception_versions": { "type": "object" }
  },
  "definitions": {
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category_id", "name", "confidence"],
      "properties": {
        "category_id": { "type": "string" },
        "name": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_refs": { "type": "array" }
      }
    },
    "tag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag_id", "canonical_tag_id", "display_name", "name_type", "source", "final_confidence", "vector_state"],
      "properties": {
        "tag_id": { "type": "string" },
        "canonical_tag_id": { "type": "string" },
        "display_name": { "type": "string" },
        "name_type": { "enum": ["standard", "alias"] },
        "source": { "enum": ["matched", "created"] },
        "model_score": { "type": "number" },
        "final_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_refs": { "type": "array" },
        "vector_state": { "enum": ["PENDING", "READY", "FAILED"] }
      }
    }
  }
}
